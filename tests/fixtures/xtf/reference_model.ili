INTERLIS 2.4;

MODEL RefTest AT "https://example.org/reftest" VERSION "2026-08-07" =

  TOPIC MainTopic =

    CLASS Location =
      Name: MANDATORY TEXT;
    END Location;

    CLASS Indicator =
      Value: MANDATORY TEXT;
      RefLocation: REFERENCE TO Location;
    END Indicator;

  END MainTopic;

END RefTest.

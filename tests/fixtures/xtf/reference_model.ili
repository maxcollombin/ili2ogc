INTERLIS 2.4;

MODEL RefTest AT "https://example.org/reftest" VERSION "2026-08-07" =

  TOPIC MainTopic =

    CLASS Location =
      Name: MANDATORY TEXT;
    END Location;

    CLASS SpecialLocation EXTENDS Location =
      Detail: TEXT;
    END SpecialLocation;

    CLASS Indicator =
      Value: MANDATORY TEXT;
      RefLocation: REFERENCE TO Location;
      RefCatalogItem: REFERENCE TO (EXTERNAL) Location;
    END Indicator;

    ASSOCIATION Location_Indicator =
      rLocation -<#> Location;
      rIndicator -- {0..*} Indicator;
    END Location_Indicator;

  END MainTopic;

END RefTest.

INTERLIS 2.3;
MODEL Axis_LV95_V1_1_d (en)
  AT "mailto:test@example.org"
  VERSION "2023-12-06" =
    IMPORTS Axis_LV95_V1_1;
    TOPIC Axis_d EXTENDS Axis_LV95_V1_1.Axis =
      VIEW view_Axis
        JOIN OF Axis_LV95_V1_1.Axis.Axis, Axis_LV95_V1_1.Axis.AxisSegment, Axis_LV95_V1_1.Axis.Sector;
        WHERE
          Axis->rAxisSegment == AxisSegment
          AND
          AxisSegment->rLinearReference == Sector; 
          =
        ATTRIBUTE
          !! Attribute names aligned to the published service
          !! ch.astra.nationalstrassenachsen (ArcGIS REST ?f=json /
          !! GetFeatureInfo), per FGDM4GS report chapter 4 - checked with
          !! scripts/crosscheck_view_attributes.py. The service's synthetic
          !! `id` and geometry-type discriminator `type_geom` are added by
          !! the publication layer, not derivable from the base model.
          wkb_geometry := AxisSegment -> Geometry;
          eigentuemer := Axis -> Owner;
          segmentname := AxisSegment -> SegmentName;
          strassennummer := Axis -> AxisName;
          bezeichnung := Axis -> AxisNameLong;
          positionscode := Axis -> AxisPositionCode;
          name := Sector -> SectorName;
          kilometerwert := Sector -> Km;
          sektorlaenge := Sector -> SectorLength;
          sortnr := Sector -> Sequence;
      END view_Axis;
    END Axis_d;
END   Axis_LV95_V1_1_d.